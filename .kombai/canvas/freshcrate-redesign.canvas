  "nodes": {
    "var_d512902d1891": {
      "type": "variant",
      "label": "FreshCrate — Editorial Fresh Market",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');\n</style>\n<div class=\"min-h-screen bg-[#fdfbf7] text-[#1f2937] font-['DM_Sans']\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"mx-auto flex max-w-[1180px] items-center justify-between border-b border-[#1f2937]/10 px-8 py-6\" data-kid=\"1-1\" data-name=\"header navigation bar\">\n        <a class=\"flex items-center gap-3 text-[#047857] no-underline\" data-kid=\"1-1-1\" data-name=\"brand logo and name link\" href=\"#\">\n            <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[#047857] text-lg font-bold text-white\" data-kid=\"1-1-1-1\" data-name=\"brand logo initial\">\n                F\n            </span>\n            <span class=\"text-xl font-bold tracking-[-0.04em]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                FreshCrate\n            </span>\n        </a>\n        <nav class=\"flex items-center gap-8 text-sm font-semibold text-[#1f2937]/70\" data-kid=\"1-1-2\" data-name=\"main navigation links\">\n            <a class=\"border-b-2 border-[#047857] pb-1 text-[#047857]\" data-kid=\"1-1-2-1\" data-name=\"home link\" href=\"#\">\n                Home\n            </a>\n            <a class=\"pb-1 hover:text-[#047857]\" data-kid=\"1-1-2-2\" data-name=\"crate plans link\" href=\"#plans\">\n                Crate Plans\n            </a>\n            <a class=\"pb-1 hover:text-[#047857]\" data-kid=\"1-1-2-3\" data-name=\"how it works link\" href=\"#\">\n                How it works\n            </a>\n            <a class=\"rounded-full bg-[#047857] px-5 py-3 text-white shadow-sm hover:bg-[#065f46]\" data-kid=\"1-1-2-4\" data-name=\"login button\" href=\"#\">\n                Log in\n            </a>\n        </nav>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\">\n        <section class=\"mx-auto grid max-w-[1180px] grid-cols-[0.88fr_1.12fr] items-stretch gap-12 px-8 pb-20 pt-16\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"flex flex-col justify-center\" data-kid=\"1-2-1-1\" data-name=\"hero content column\">\n                <div class=\"mb-7 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.22em] text-[#ea580c]\" data-kid=\"1-2-1-1-1\" data-name=\"hero subtitle section\">\n                    <span class=\"h-px w-10 bg-[#ea580c]\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero subtitle underline\">\n                    </span>\n                    Fresh from Greater Accra\n                </div>\n                <h1 class=\"max-w-[600px] font-['Playfair_Display'] text-[4.9rem] font-bold leading-[0.98] tracking-[-0.055em] text-[#1f2937]\" data-kid=\"1-2-1-1-2\" data-name=\"hero main headline\">\n                    Farm-fresh produce.\n                    <span class=\"text-[#047857]\" data-kid=\"1-2-1-1-2-1\" data-name=\"hero accent text\">\n                        Delivered like clockwork.\n                    </span>\n                </h1>\n                <p class=\"mt-8 max-w-[540px] text-lg leading-8 text-[#1f2937]/70\" data-kid=\"1-2-1-1-3\" data-name=\"hero description text\">\n                    A weekly subscription of seasonal fruit and vegetables, sourced directly from smallholder farms in the Greater Accra Region and delivered to your door within 48 hours of harvest — no markets, no negotiation, no surprises.\n                </p>\n                <div class=\"mt-10 flex items-center gap-4\" data-kid=\"1-2-1-1-4\" data-name=\"hero primary action buttons\">\n                    <a class=\"rounded-full bg-[#047857] px-7 py-4 text-sm font-bold text-white shadow-[0_12px_24px_rgba(4,120,87,0.18)] hover:bg-[#065f46]\" data-kid=\"1-2-1-1-4-1\" data-name=\"pick your crate button\" href=\"#plans\">\n                        Pick Your Crate\n                    </a>\n                    <a class=\"rounded-full border border-[#1f2937]/20 px-7 py-4 text-sm font-bold text-[#1f2937] hover:border-[#047857] hover:text-[#047857]\" data-kid=\"1-2-1-1-4-2\" data-name=\"create account button\" href=\"#\">\n                        Create an account\n                    </a>\n                </div>\n                <div class=\"mt-12 flex items-center gap-4 text-xs font-semibold text-[#1f2937]/55\" data-kid=\"1-2-1-1-5\" data-name=\"social proof section\">\n                    <div class=\"flex -space-x-2\" data-kid=\"1-2-1-1-5-1\" data-name=\"customer avatars stack\">\n                        <img alt=\"FreshCrate customer Ama\" class=\"h-8 w-8 rounded-full border-2 border-[#fdfbf7] object-cover\" data-kid=\"1-2-1-1-5-1-1\" data-name=\"customer avatar 1\" decoding=\"async\" height=\"32\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=ama\" width=\"32\"/>\n                        <img alt=\"FreshCrate customer Kojo\" class=\"h-8 w-8 rounded-full border-2 border-[#fdfbf7] object-cover\" data-kid=\"1-2-1-1-5-1-2\" data-name=\"customer avatar 2\" decoding=\"async\" height=\"32\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=kojo\" width=\"32\"/>\n                        <img alt=\"FreshCrate customer Esi\" class=\"h-8 w-8 rounded-full border-2 border-[#fdfbf7] object-cover\" data-kid=\"1-2-1-1-5-1-3\" data-name=\"customer avatar 3\" decoding=\"async\" height=\"32\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=esi\" width=\"32\"/>\n                    </div>\n                    <span data-kid=\"1-2-1-1-5-2\" data-name=\"social proof text\">\n                        Trusted by households across Accra\n                    </span>\n                </div>\n            </div>\n            <div class=\"relative min-h-[620px] overflow-hidden rounded-[2rem] bg-[#dfe9dc]\" data-kid=\"1-2-1-2\" data-name=\"hero image container\">\n                <img alt=\"Close up of vibrant fresh tomatoes, peppers and greens — Marion Mesbah on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"1-2-1-2-1\" data-name=\"hero lifestyle image\" decoding=\"async\" height=\"1100\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1694957932193-576ddb4cf4f9?auto=format&w=1200&q=80&fit=crop\" width=\"900\"/>\n                <div class=\"absolute inset-x-7 bottom-7 flex items-end justify-between rounded-2xl bg-[#fdfbf7]/95 p-5 backdrop-blur-sm\" data-kid=\"1-2-1-2-2\" data-name=\"featured harvest banner\">\n                    <div data-kid=\"1-2-1-2-2-1\" data-name=\"harvest banner content\">\n                        <p class=\"text-xs font-bold uppercase tracking-[0.18em] text-[#ea580c]\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"harvest banner label\">\n                            This week’s harvest\n                        </p>\n                        <p class=\"mt-1 font-['Playfair_Display'] text-2xl font-bold text-[#1f2937]\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"harvest banner headline\">\n                            Bright, local, in season.\n                        </p>\n                    </div>\n                    <span class=\"flex h-12 w-12 items-center justify-center rounded-full bg-[#eab308] text-xl text-[#1f2937]\" data-kid=\"1-2-1-2-2-2\" data-name=\"harvest banner arrow icon\">\n                        ↗\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"FreshCrate benefits\" class=\"border-y border-[#1f2937]/10 bg-[#f5efe4]\" data-kid=\"1-2-2\" data-name=\"benefits section\">\n            <div class=\"mx-auto grid max-w-[1180px] grid-cols-4 divide-x divide-[#1f2937]/10 px-8\" data-kid=\"1-2-2-1\" data-name=\"benefits grid container\">\n                <div class=\"px-6 py-8 first:pl-0\" data-kid=\"1-2-2-1-1\" data-name=\"benefit card 1\">\n                    <p class=\"font-['Playfair_Display'] text-2xl font-bold text-[#047857]\" data-kid=\"1-2-2-1-1-1\" data-name=\"benefit 1 title\">\n                        Within 48 hours\n                    </p>\n                    <p class=\"mt-3 text-sm leading-6 text-[#1f2937]/65\" data-kid=\"1-2-2-1-1-2\" data-name=\"benefit 1 description\">\n                        From farm gate to your kitchen counter. The traditional market chain takes 4–7 days; FreshCrate cuts it to under 48 hours.\n                    </p>\n                </div>\n                <div class=\"px-6 py-8\" data-kid=\"1-2-2-1-2\" data-name=\"benefit card 2\">\n                    <p class=\"font-['Playfair_Display'] text-2xl font-bold text-[#047857]\" data-kid=\"1-2-2-1-2-1\" data-name=\"benefit 2 title\">\n                        Less waste, more farm income\n                    </p>\n                    <p class=\"mt-3 text-sm leading-6 text-[#1f2937]/65\" data-kid=\"1-2-2-1-2-2\" data-name=\"benefit 2 description\">\n                        Subscription demand is matched to farm supply. We aim to cut in-chain produce loss from 20–50% to under 10% and raise partner-farm incomes.\n                    </p>\n                </div>\n                <div class=\"px-6 py-8\" data-kid=\"1-2-2-1-3\" data-name=\"benefit card 3\">\n                    <p class=\"font-['Playfair_Display'] text-2xl font-bold text-[#047857]\" data-kid=\"1-2-2-1-3-1\" data-name=\"benefit 3 title\">\n                        Transparent, consistent pricing\n                    </p>\n                    <p class=\"mt-3 text-sm leading-6 text-[#1f2937]/65\" data-kid=\"1-2-2-1-3-2\" data-name=\"benefit 3 description\">\n                        One fixed weekly price. No spot-market volatility, no price negotiation. Quality is graded A/B/C before packing.\n                    </p>\n                </div>\n                <div class=\"px-6 py-8 last:pr-0\" data-kid=\"1-2-2-1-4\" data-name=\"benefit card 4\">\n                    <p class=\"font-['Playfair_Display'] text-2xl font-bold text-[#047857]\" data-kid=\"1-2-2-1-4-1\" data-name=\"benefit 4 title\">\n                        Pay with Mobile Money\n                    </p>\n                    <p class=\"mt-3 text-sm leading-6 text-[#1f2937]/65\" data-kid=\"1-2-2-1-4-2\" data-name=\"benefit 4 description\">\n                        Auto-billing via MTN Mobile Money (and card) on your subscription cycle. Cashless, traceable, convenient.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto grid max-w-[1180px] grid-cols-[0.8fr_1.2fr] gap-16 px-8 py-24\" data-kid=\"1-2-3\" data-name=\"how it works section\" id=\"plans\">\n            <div data-kid=\"1-2-3-1\" data-name=\"how it works description column\">\n                <p class=\"text-xs font-bold uppercase tracking-[0.2em] text-[#ea580c]\" data-kid=\"1-2-3-1-1\" data-name=\"how it works subtitle\">\n                    From farm to front door\n                </p>\n                <h2 class=\"mt-4 max-w-[390px] font-['Playfair_Display'] text-5xl font-bold leading-[1.02] tracking-[-0.045em]\" data-kid=\"1-2-3-1-2\" data-name=\"how it works headline\">\n                    A better way to bring the market home.\n                </h2>\n                <p class=\"mt-6 max-w-[380px] text-base leading-7 text-[#1f2937]/65\" data-kid=\"1-2-3-1-3\" data-name=\"how it works body text\">\n                    Choose a crate, make it yours, and let our local network handle the rest.\n                </p>\n                <div class=\"mt-12 overflow-hidden rounded-2xl\" data-kid=\"1-2-3-1-4\" data-name=\"how it works image container\">\n                    <img alt=\"Farmer holding a fresh produce crate — Vitaly Gariev on Unsplash\" class=\"h-64 w-full object-cover\" data-kid=\"1-2-3-1-4-1\" data-name=\"farmer image\" decoding=\"async\" height=\"460\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1758524056233-9e2dfb03a473?auto=format&w=640&q=80&fit=crop\" width=\"640\"/>\n                </div>\n            </div>\n            <div class=\"relative pt-2\" data-kid=\"1-2-3-2\" data-name=\"how it works steps list\">\n                <div class=\"absolute left-[19px] top-8 h-[calc(100%-80px)] w-px bg-[#047857]/25\" data-kid=\"1-2-3-2-1\" data-name=\"vertical step progress line\">\n                </div>\n                <div class=\"relative flex gap-7 pb-12\" data-kid=\"1-2-3-2-2\" data-name=\"step 1\">\n                    <span class=\"z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#047857] font-bold text-white ring-8 ring-[#fdfbf7]\" data-kid=\"1-2-3-2-2-1\" data-name=\"step 1 indicator\">\n                        1\n                    </span>\n                    <div data-kid=\"1-2-3-2-2-2\" data-name=\"step 1 content\">\n                        <p class=\"text-xs font-bold uppercase tracking-[0.18em] text-[#ea580c]\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"step 1 subheader\">\n                            01 / Choose\n                        </p>\n                        <h3 class=\"mt-2 font-['Playfair_Display'] text-3xl font-bold\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"step 1 title\">\n                            Choose a crate\n                        </h3>\n                        <p class=\"mt-2 max-w-[420px] text-sm leading-6 text-[#1f2937]/65\" data-kid=\"1-2-3-2-2-2-3\" data-name=\"step 1 description\">\n                            Small, Family, Premium, or Restaurant.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"relative flex gap-7 pb-12\" data-kid=\"1-2-3-2-3\" data-name=\"step 2\">\n                    <span class=\"z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#eab308] font-bold text-[#1f2937] ring-8 ring-[#fdfbf7]\" data-kid=\"1-2-3-2-3-1\" data-name=\"step 2 indicator\">\n                        2\n                    </span>\n                    <div data-kid=\"1-2-3-2-3-2\" data-name=\"step 2 content\">\n                        <p class=\"text-xs font-bold uppercase tracking-[0.18em] text-[#ea580c]\" data-kid=\"1-2-3-2-3-2-1\" data-name=\"step 2 subheader\">\n                            02 / Make it yours\n                        </p>\n                        <h3 class=\"mt-2 font-['Playfair_Display'] text-3xl font-bold\" data-kid=\"1-2-3-2-3-2-2\" data-name=\"step 2 title\">\n                            Customize\n                        </h3>\n                        <p class=\"mt-2 max-w-[420px] text-sm leading-6 text-[#1f2937]/65\" data-kid=\"1-2-3-2-3-2-3\" data-name=\"step 2 description\">\n                            Swap or add seasonal produce you love (or skip what you don’t).\n                        </p>\n                    </div>\n                </div>\n                <div class=\"relative flex gap-7 pb-12\" data-kid=\"1-2-3-2-4\" data-name=\"step 3\">\n                    <span class=\"z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#047857] font-bold text-white ring-8 ring-[#fdfbf7]\" data-kid=\"1-2-3-2-4-1\" data-name=\"step 3 indicator\">\n                        3\n                    </span>\n                    <div data-kid=\"1-2-3-2-4-2\" data-name=\"step 3 content\">\n                        <p class=\"text-xs font-bold uppercase tracking-[0.18em] text-[#ea580c]\" data-kid=\"1-2-3-2-4-2-1\" data-name=\"step 3 subheader\">\n                            03 / Harvest + pack\n                        </p>\n                        <h3 class=\"mt-2 font-['Playfair_Display'] text-3xl font-bold\" data-kid=\"1-2-3-2-4-2-2\" data-name=\"step 3 title\">\n                            We harvest + pack\n                        </h3>\n                        <p class=\"mt-2 max-w-[420px] text-sm leading-6 text-[#1f2937]/65\" data-kid=\"1-2-3-2-4-2-3\" data-name=\"step 3 description\">\n                            Farms harvest to order; our hub grades and packs your crate.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"relative flex gap-7\" data-kid=\"1-2-3-2-5\" data-name=\"step 4\">\n                    <span class=\"z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#047857] font-bold text-white ring-8 ring-[#fdfbf7]\" data-kid=\"1-2-3-2-5-1\" data-name=\"step 4 indicator\">\n                        4\n                    </span>\n                    <div data-kid=\"1-2-3-2-5-2\" data-name=\"step 4 content\">\n                        <p class=\"text-xs font-bold uppercase tracking-[0.18em] text-[#ea580c]\" data-kid=\"1-2-3-2-5-2-1\" data-name=\"step 4 subheader\">\n                            04 / On its way\n                        </p>\n                        <h3 class=\"mt-2 font-['Playfair_Display'] text-3xl font-bold\" data-kid=\"1-2-3-2-5-2-2\" data-name=\"step 4 title\">\n                            Doorstep delivery\n                        </h3>\n                        <p class=\"mt-2 max-w-[420px] text-sm leading-6 text-[#1f2937]/65\" data-kid=\"1-2-3-2-5-2-3\" data-name=\"step 4 description\">\n                            Route-optimized delivery within 48h of harvest.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1180px] px-8 pb-20\" data-kid=\"1-2-4\" data-name=\"call to action section\">\n            <div class=\"relative overflow-hidden rounded-[2rem] bg-[#047857] px-10 py-12 text-white\" data-kid=\"1-2-4-1\" data-name=\"cta card container\">\n                <div class=\"relative z-10 max-w-2xl\" data-kid=\"1-2-4-1-1\" data-name=\"cta content block\">\n                    <p class=\"text-xs font-bold uppercase tracking-[0.22em] text-[#facc15]\" data-kid=\"1-2-4-1-1-1\" data-name=\"cta subtitle\">\n                        A fresher weekly ritual\n                    </p>\n                    <h2 class=\"mt-4 font-['Playfair_Display'] text-5xl font-bold leading-tight tracking-[-0.04em]\" data-kid=\"1-2-4-1-1-2\" data-name=\"cta headline\">\n                        Good food starts with good timing.\n                    </h2>\n                    <p class=\"mt-4 max-w-xl text-base leading-7 text-white/75\" data-kid=\"1-2-4-1-1-3\" data-name=\"cta description\">\n                        Seasonal produce, fairer farm income, and one less thing to negotiate at the market.\n                    </p>\n                    <a class=\"mt-7 inline-flex rounded-full bg-[#fdfbf7] px-6 py-3 text-sm font-bold text-[#047857] hover:bg-[#f5efe4]\" data-kid=\"1-2-4-1-1-4\" data-name=\"cta button\" href=\"#plans\">\n                        Pick Your Crate\n                    </a>\n                </div>\n                <div class=\"absolute -right-8 -top-16 h-72 w-72 rounded-full border-[32px] border-[#eab308]/30\" data-kid=\"1-2-4-1-2\" data-name=\"decorative circle 1\">\n                </div>\n                <div class=\"absolute -bottom-32 right-32 h-72 w-72 rounded-full border-[22px] border-[#ea580c]/30\" data-kid=\"1-2-4-1-3\" data-name=\"decorative circle 2\">\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#1f2937]/10 bg-[#f5efe4]\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"mx-auto flex max-w-[1180px] items-center justify-between px-8 py-7 text-xs text-[#1f2937]/60\" data-kid=\"1-3-1\" data-name=\"footer content container\">\n            <p data-kid=\"1-3-1-1\" data-name=\"footer branding info\">\n                <span class=\"font-bold text-[#047857]\" data-kid=\"1-3-1-1-1\" data-name=\"footer brand name\">\n                    FreshCrate\n                </span>\n                · Farm-fresh produce delivered within 48h of harvest · Greater Accra\n            </p>\n            <p data-kid=\"1-3-1-2\" data-name=\"footer mission statement\">\n                Reducing post-harvest loss by connecting smallholder farmers directly to urban households.\n            </p>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-08-01T19:15:06.576655+00:00",
      "modified": "2026-08-01T19:15:29.203778+00:00",
      "id": "var_d512902d1891"
    },
    "var_25670be397b6": {
      "type": "variant",
      "label": "FreshCrate — Operational 48-hour",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Condensed:wght@500;600;700&family=Roboto+Mono:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n  .fc-body { font-family: 'Inter', sans-serif; background: #f3f4f6; color: #111111; }\n  .fc-display { font-family: 'Roboto Condensed', sans-serif; }\n  .fc-mono { font-family: 'Roboto Mono', monospace; }\n  .fc-rule { border-color: #d1d5db; }\n  .fc-ink { color: #111111; }\n  .fc-emerald { color: #047857; }\n  .fc-paper { background: #ffffff; }\n</style>\n<div class=\"fc-body min-h-screen\" data-kid=\"1\">\n    <header class=\"sticky top-0 z-20 border-b border-gray-300 bg-white/95 backdrop-blur-sm\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex max-w-[1280px] items-center justify-between px-8 py-4\" data-kid=\"1-1-1\">\n            <a aria-label=\"FreshCrate home\" class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" href=\"#\">\n                <span aria-hidden=\"true\" class=\"flex h-9 w-9 items-center justify-center bg-emerald-700 text-white text-lg\" data-kid=\"1-1-1-1-1\">\n                    <i class=\"ti ti-leaf\" data-kid=\"1-1-1-1-1-1\">\n                    </i>\n                </span>\n                <span class=\"fc-display text-[22px] font-bold tracking-tight\" data-kid=\"1-1-1-1-2\">\n                    FRESHCRATE\n                    <span class=\"text-emerald-700\" data-kid=\"1-1-1-1-2-1\">\n                        .\n                    </span>\n                </span>\n            </a>\n            <nav class=\"hidden items-center gap-8 text-[12px] font-semibold uppercase tracking-[0.18em] text-gray-600 md:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"border-b-2 border-emerald-700 pb-1 text-black\" data-kid=\"1-1-1-2-1\" href=\"#home\">\n                    Home\n                </a>\n                <a class=\"pb-1 hover:text-emerald-700\" data-kid=\"1-1-1-2-2\" href=\"#crates\">\n                    Crate plans\n                </a>\n                <a class=\"pb-1 hover:text-emerald-700\" data-kid=\"1-1-1-2-3\" href=\"#process\">\n                    How it works\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-3\">\n                <span class=\"hidden text-[11px] uppercase tracking-[0.16em] text-gray-500 sm:inline\" data-kid=\"1-1-1-3-1\" data-name=\"delivery region and estimated time\">\n                    Greater Accra · 48h\n                </span>\n                <a class=\"border border-black px-4 py-2 text-[12px] font-semibold uppercase tracking-[0.16em] hover:bg-black hover:text-white\" data-kid=\"1-1-1-3-2\" href=\"#login\">\n                    Login\n                </a>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1280px] bg-white\" data-kid=\"1-2\" id=\"home\">\n        <section class=\"grid border-x border-b border-gray-300 lg:grid-cols-[1.2fr_0.8fr]\" data-kid=\"1-2-1\">\n            <div class=\"flex min-h-[600px] flex-col justify-between border-b border-gray-300 p-8 sm:p-12 lg:border-b-0 lg:border-r lg:p-16\" data-kid=\"1-2-1-1\">\n                <div class=\"flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.2em] text-gray-500\" data-kid=\"1-2-1-1-1\">\n                    <span class=\"h-2 w-2 bg-emerald-600\" data-kid=\"1-2-1-1-1-1\">\n                    </span>\n                    <span data-kid=\"1-2-1-1-1-2\">\n                        Harvest-to-door system / Accra\n                    </span>\n                </div>\n                <div class=\"max-w-[650px] py-14\" data-kid=\"1-2-1-1-2\">\n                    <p class=\"fc-mono mb-5 text-[11px] uppercase tracking-[0.18em] text-emerald-700\" data-kid=\"1-2-1-1-2-1\">\n                        01 / Fresh supply, on schedule\n                    </p>\n                    <h1 class=\"fc-display max-w-[700px] text-6xl font-bold uppercase leading-[0.92] tracking-[-0.045em] text-black sm:text-7xl xl:text-[86px]\" data-kid=\"1-2-1-1-2-2\">\n                        Farm-fresh produce. Delivered like clockwork.\n                    </h1>\n                    <p class=\"mt-8 max-w-[620px] text-base leading-7 text-gray-600 sm:text-lg\" data-kid=\"1-2-1-1-2-3\">\n                        A weekly subscription of seasonal fruit and vegetables, sourced directly from smallholder farms in the Greater Accra Region and delivered to your door within 48 hours of harvest — no markets, no negotiation, no surprises.\n                    </p>\n                    <div class=\"mt-10 flex flex-wrap gap-3\" data-kid=\"1-2-1-1-2-4\">\n                        <a class=\"inline-flex items-center gap-3 bg-emerald-700 px-6 py-4 text-[12px] font-bold uppercase tracking-[0.16em] text-white hover:bg-black\" data-kid=\"1-2-1-1-2-4-1\" href=\"#crates\">\n                            Pick Your Crate\n                            <span aria-hidden=\"true\" class=\"text-base\" data-kid=\"1-2-1-1-2-4-1-1\">\n                                ↗\n                            </span>\n                        </a>\n                        <a class=\"inline-flex items-center gap-3 border border-black px-6 py-4 text-[12px] font-bold uppercase tracking-[0.16em] text-black hover:bg-gray-100\" data-kid=\"1-2-1-1-2-4-2\" href=\"#register\">\n                            Create an account\n                            <span aria-hidden=\"true\" class=\"text-base\" data-kid=\"1-2-1-1-2-4-2-1\">\n                                ↗\n                            </span>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-3 border-t border-gray-300 pt-5\" data-kid=\"1-2-1-1-3\">\n                    <div class=\"border-r border-gray-300 pr-4\" data-kid=\"1-2-1-1-3-1\">\n                        <p class=\"fc-mono text-2xl font-semibold\" data-kid=\"1-2-1-1-3-1-1\">\n                            48\n                            <span class=\"text-emerald-700\" data-kid=\"1-2-1-1-3-1-1-1\">\n                                h\n                            </span>\n                        </p>\n                        <p class=\"mt-1 text-[10px] uppercase tracking-[0.16em] text-gray-500\" data-kid=\"1-2-1-1-3-1-2\">\n                            Farm to door\n                        </p>\n                    </div>\n                    <div class=\"border-r border-gray-300 px-4\" data-kid=\"1-2-1-1-3-2\">\n                        <p class=\"fc-mono text-2xl font-semibold\" data-kid=\"1-2-1-1-3-2-1\">\n                            04\n                        </p>\n                        <p class=\"mt-1 text-[10px] uppercase tracking-[0.16em] text-gray-500\" data-kid=\"1-2-1-1-3-2-2\">\n                            Delivery zones\n                        </p>\n                    </div>\n                    <div class=\"pl-4\" data-kid=\"1-2-1-1-3-3\">\n                        <p class=\"fc-mono text-2xl font-semibold\" data-kid=\"1-2-1-1-3-3-1\">\n                            A/B/C\n                        </p>\n                        <p class=\"mt-1 text-[10px] uppercase tracking-[0.16em] text-gray-500\" data-kid=\"1-2-1-1-3-3-2\">\n                            Quality graded\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"relative min-h-[600px] overflow-hidden bg-gray-200\" data-kid=\"1-2-1-2\">\n                <img alt=\"Overhead view of organized logistical boxes in a warehouse, by Cosmin Andrei Buzamat on Unsplash\" class=\"h-full min-h-[600px] w-full object-cover grayscale-[15%]\" data-kid=\"1-2-1-2-1\" data-name=\"logistical boxes hero image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1782398138737-e9be9a35545e?auto=format&w=1200&q=80&fit=crop\"/>\n                <div class=\"absolute inset-0 bg-gradient-to-t from-black/70 via-black/5 to-transparent\" data-kid=\"1-2-1-2-2\">\n                </div>\n                <div class=\"absolute left-6 top-6 border border-white/60 bg-black/55 px-4 py-3 text-white backdrop-blur-sm\" data-kid=\"1-2-1-2-3\">\n                    <p class=\"fc-mono text-[10px] uppercase tracking-[0.18em] text-emerald-300\" data-kid=\"1-2-1-2-3-1\">\n                        Live service status\n                    </p>\n                    <div class=\"mt-2 flex items-center gap-2 text-sm font-semibold\" data-kid=\"1-2-1-2-3-2\" data-name=\"live route status indicator\">\n                        <span class=\"h-2 w-2 rounded-full bg-emerald-400\" data-kid=\"1-2-1-2-3-2-1\">\n                        </span>\n                        Routes operating normally\n                    </div>\n                </div>\n                <div class=\"absolute bottom-8 left-8 right-8 text-white\" data-kid=\"1-2-1-2-4\">\n                    <p class=\"fc-mono text-[11px] uppercase tracking-[0.18em] text-emerald-300\" data-kid=\"1-2-1-2-4-1\">\n                        Built around the harvest\n                    </p>\n                    <p class=\"fc-display mt-2 max-w-sm text-4xl font-bold uppercase leading-none\" data-kid=\"1-2-1-2-4-2\">\n                        Freshness is a logistics problem. We solved it.\n                    </p>\n                    <div class=\"mt-6 flex items-center gap-3 border-t border-white/40 pt-4 text-[11px] uppercase tracking-[0.16em] text-white/80\" data-kid=\"1-2-1-2-4-3\">\n                        <span class=\"text-emerald-300\" data-kid=\"1-2-1-2-4-3-1\">\n                            ●\n                        </span>\n                        Farm partners / Hub / Doorstep\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-x border-b border-gray-300\" data-kid=\"1-2-2\" id=\"crates\">\n            <div class=\"flex flex-col justify-between gap-4 border-b border-gray-300 p-8 sm:flex-row sm:items-end sm:p-10\" data-kid=\"1-2-2-1\">\n                <div data-kid=\"1-2-2-1-1\">\n                    <p class=\"fc-mono text-[11px] uppercase tracking-[0.18em] text-emerald-700\" data-kid=\"1-2-2-1-1-1\">\n                        Why FreshCrate / 02\n                    </p>\n                    <h2 class=\"fc-display mt-2 text-4xl font-bold uppercase tracking-[-0.03em]\" data-kid=\"1-2-2-1-1-2\">\n                        A better chain, made visible.\n                    </h2>\n                </div>\n                <p class=\"max-w-sm text-sm leading-6 text-gray-500\" data-kid=\"1-2-2-1-2\">\n                    Subscription demand meets farm supply with a clear route from harvest to your kitchen counter.\n                </p>\n            </div>\n            <div class=\"grid divide-y divide-gray-300 md:grid-cols-2 md:divide-x md:divide-y-0\" data-kid=\"1-2-2-2\">\n                <div class=\"border-b border-gray-300 p-8 md:border-b-0 md:border-r lg:p-10\" data-kid=\"1-2-2-2-1\">\n                    <div class=\"flex items-start justify-between\" data-kid=\"1-2-2-2-1-1\">\n                        <span class=\"flex h-10 w-10 items-center justify-center border border-emerald-700 text-xl text-emerald-700\" data-kid=\"1-2-2-2-1-1-1\">\n                            <i class=\"ti ti-clock\" data-kid=\"1-2-2-2-1-1-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"fc-mono text-[11px] text-gray-400\" data-kid=\"1-2-2-2-1-1-2\">\n                            01 / 04\n                        </span>\n                    </div>\n                    <h3 class=\"fc-display mt-12 text-2xl font-bold uppercase\" data-kid=\"1-2-2-2-1-2\">\n                        Within 48 hours\n                    </h3>\n                    <p class=\"mt-3 max-w-md text-sm leading-6 text-gray-600\" data-kid=\"1-2-2-2-1-3\">\n                        From farm gate to your kitchen counter. The traditional market chain takes 4–7 days; FreshCrate cuts it to under 48 hours.\n                    </p>\n                </div>\n                <div class=\"border-b border-gray-300 p-8 md:border-b-0 lg:p-10\" data-kid=\"1-2-2-2-2\">\n                    <div class=\"flex items-start justify-between\" data-kid=\"1-2-2-2-2-1\">\n                        <span class=\"flex h-10 w-10 items-center justify-center border border-emerald-700 text-xl text-emerald-700\" data-kid=\"1-2-2-2-2-1-1\">\n                            <i class=\"ti ti-leaf\" data-kid=\"1-2-2-2-2-1-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"fc-mono text-[11px] text-gray-400\" data-kid=\"1-2-2-2-2-1-2\">\n                            02 / 04\n                        </span>\n                    </div>\n                    <h3 class=\"fc-display mt-12 text-2xl font-bold uppercase\" data-kid=\"1-2-2-2-2-2\">\n                        Less waste, more farm income\n                    </h3>\n                    <p class=\"mt-3 max-w-md text-sm leading-6 text-gray-600\" data-kid=\"1-2-2-2-2-3\">\n                        Subscription demand is matched to farm supply. We aim to cut in-chain produce loss from 20–50% to under 10% and raise partner-farm incomes.\n                    </p>\n                </div>\n                <div class=\"border-t border-gray-300 p-8 md:border-r lg:p-10\" data-kid=\"1-2-2-2-3\">\n                    <div class=\"flex items-start justify-between\" data-kid=\"1-2-2-2-3-1\">\n                        <span class=\"flex h-10 w-10 items-center justify-center border border-emerald-700 text-xl text-emerald-700\" data-kid=\"1-2-2-2-3-1-1\">\n                            <i class=\"ti ti-badge\" data-kid=\"1-2-2-2-3-1-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"fc-mono text-[11px] text-gray-400\" data-kid=\"1-2-2-2-3-1-2\">\n                            03 / 04\n                        </span>\n                    </div>\n                    <h3 class=\"fc-display mt-12 text-2xl font-bold uppercase\" data-kid=\"1-2-2-2-3-2\">\n                        Transparent, consistent pricing\n                    </h3>\n                    <p class=\"mt-3 max-w-md text-sm leading-6 text-gray-600\" data-kid=\"1-2-2-2-3-3\">\n                        One fixed weekly price. No spot-market volatility, no price negotiation. Quality is graded A/B/C before packing.\n                    </p>\n                </div>\n                <div class=\"border-t border-gray-300 p-8 lg:p-10\" data-kid=\"1-2-2-2-4\">\n                    <div class=\"flex items-start justify-between\" data-kid=\"1-2-2-2-4-1\">\n                        <span class=\"flex h-10 w-10 items-center justify-center border border-emerald-700 text-xl text-emerald-700\" data-kid=\"1-2-2-2-4-1-1\">\n                            <i class=\"ti ti-device-mobile\" data-kid=\"1-2-2-2-4-1-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"fc-mono text-[11px] text-gray-400\" data-kid=\"1-2-2-2-4-1-2\">\n                            04 / 04\n                        </span>\n                    </div>\n                    <h3 class=\"fc-display mt-12 text-2xl font-bold uppercase\" data-kid=\"1-2-2-2-4-2\">\n                        Pay with Mobile Money\n                    </h3>\n                    <p class=\"mt-3 max-w-md text-sm leading-6 text-gray-600\" data-kid=\"1-2-2-2-4-3\">\n                        Auto-billing via MTN Mobile Money (and card) on your subscription cycle. Cashless, traceable, convenient.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-x border-b border-gray-300 bg-gray-100\" data-kid=\"1-2-3\" id=\"process\">\n            <div class=\"flex flex-col justify-between gap-5 border-b border-gray-300 p-8 sm:flex-row sm:items-end sm:p-10\" data-kid=\"1-2-3-1\">\n                <div data-kid=\"1-2-3-1-1\">\n                    <p class=\"fc-mono text-[11px] uppercase tracking-[0.18em] text-emerald-700\" data-kid=\"1-2-3-1-1-1\">\n                        Operational flow / 03\n                    </p>\n                    <h2 class=\"fc-display mt-2 text-4xl font-bold uppercase tracking-[-0.03em]\" data-kid=\"1-2-3-1-1-2\">\n                        How it works\n                    </h2>\n                </div>\n                <span class=\"fc-mono text-xs uppercase tracking-[0.12em] text-gray-500\" data-kid=\"1-2-3-1-2\">\n                    One route / Four checkpoints / Zero guesswork\n                </span>\n            </div>\n            <div class=\"overflow-x-auto p-8 lg:p-10\" data-kid=\"1-2-3-2\">\n                <div class=\"min-w-[920px]\" data-kid=\"1-2-3-2-1\">\n                    <div class=\"relative mb-10 h-px bg-gray-400\" data-kid=\"1-2-3-2-1-1\">\n                        <div class=\"absolute left-0 top-1/2 h-3 w-3 -translate-y-1/2 rounded-full border-2 border-emerald-700 bg-gray-100\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"operational timeline start checkpoint\">\n                        </div>\n                        <div class=\"absolute left-1/3 top-1/2 h-3 w-3 -translate-y-1/2 rounded-full border-2 border-emerald-700 bg-gray-100\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"operational timeline second checkpoint\">\n                        </div>\n                        <div class=\"absolute left-2/3 top-1/2 h-3 w-3 -translate-y-1/2 rounded-full border-2 border-emerald-700 bg-gray-100\" data-kid=\"1-2-3-2-1-1-3\" data-name=\"operational timeline third checkpoint\">\n                        </div>\n                        <div class=\"absolute right-0 top-1/2 h-3 w-3 -translate-y-1/2 rounded-full border-2 border-emerald-700 bg-emerald-700\" data-kid=\"1-2-3-2-1-1-4\" data-name=\"operational timeline end checkpoint\">\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-4 gap-8\" data-kid=\"1-2-3-2-1-2\">\n                        <div data-kid=\"1-2-3-2-1-2-1\">\n                            <p class=\"fc-mono text-emerald-700 text-xs font-semibold\" data-kid=\"1-2-3-2-1-2-1-1\">\n                                T−48H / ORDER\n                            </p>\n                            <h3 class=\"fc-display mt-3 text-2xl font-bold uppercase\" data-kid=\"1-2-3-2-1-2-1-2\">\n                                Choose a crate\n                            </h3>\n                            <p class=\"mt-3 max-w-[210px] text-sm leading-6 text-gray-600\" data-kid=\"1-2-3-2-1-2-1-3\">\n                                Small, Family, Premium, or Restaurant.\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-3-2-1-2-2\">\n                            <p class=\"fc-mono text-emerald-700 text-xs font-semibold\" data-kid=\"1-2-3-2-1-2-2-1\">\n                                T−36H / EDIT\n                            </p>\n                            <h3 class=\"fc-display mt-3 text-2xl font-bold uppercase\" data-kid=\"1-2-3-2-1-2-2-2\">\n                                Customize\n                            </h3>\n                            <p class=\"mt-3 max-w-[210px] text-sm leading-6 text-gray-600\" data-kid=\"1-2-3-2-1-2-2-3\">\n                                Swap or add seasonal produce you love (or skip what you don't).\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-3-2-1-2-3\">\n                            <p class=\"fc-mono text-emerald-700 text-xs font-semibold\" data-kid=\"1-2-3-2-1-2-3-1\">\n                                T−24H / PACK\n                            </p>\n                            <h3 class=\"fc-display mt-3 text-2xl font-bold uppercase\" data-kid=\"1-2-3-2-1-2-3-2\">\n                                We harvest + pack\n                            </h3>\n                            <p class=\"mt-3 max-w-[210px] text-sm leading-6 text-gray-600\" data-kid=\"1-2-3-2-1-2-3-3\">\n                                Farms harvest to order; our hub grades and packs your crate.\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-3-2-1-2-4\">\n                            <p class=\"fc-mono text-emerald-700 text-xs font-semibold\" data-kid=\"1-2-3-2-1-2-4-1\">\n                                T+00H / ARRIVE\n                            </p>\n                            <h3 class=\"fc-display mt-3 text-2xl font-bold uppercase\" data-kid=\"1-2-3-2-1-2-4-2\">\n                                Doorstep delivery\n                            </h3>\n                            <p class=\"mt-3 max-w-[210px] text-sm leading-6 text-gray-600\" data-kid=\"1-2-3-2-1-2-4-3\">\n                                Route-optimized delivery within 48h of harvest.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"grid border-x border-b border-gray-300 lg:grid-cols-[1fr_0.65fr]\" data-kid=\"1-2-4\">\n            <div class=\"grid grid-cols-2 border-b border-gray-300 sm:grid-cols-4 lg:border-b-0 lg:border-r\" data-kid=\"1-2-4-1\">\n                <div class=\"border-b border-r border-gray-300 p-6 sm:border-b-0 lg:p-8\" data-kid=\"1-2-4-1-1\">\n                    <p class=\"fc-mono text-3xl font-semibold\" data-kid=\"1-2-4-1-1-1\">\n                        20–50%\n                    </p>\n                    <p class=\"mt-2 text-[10px] uppercase tracking-[0.14em] text-gray-500\" data-kid=\"1-2-4-1-1-2\">\n                        Typical in-chain loss\n                    </p>\n                </div>\n                <div class=\"border-b border-gray-300 p-6 sm:border-b-0 sm:border-r lg:p-8\" data-kid=\"1-2-4-1-2\">\n                    <p class=\"fc-mono text-3xl font-semibold text-emerald-700\" data-kid=\"1-2-4-1-2-1\">\n                        <10%\n                    </p>\n                    <p class=\"mt-2 text-[10px] uppercase tracking-[0.14em] text-gray-500\" data-kid=\"1-2-4-1-2-2\">\n                        Our target\n                    </p>\n                </div>\n                <div class=\"border-r border-gray-300 p-6 lg:p-8\" data-kid=\"1-2-4-1-3\">\n                    <p class=\"fc-mono text-3xl font-semibold\" data-kid=\"1-2-4-1-3-1\">\n                        A/B/C\n                    </p>\n                    <p class=\"mt-2 text-[10px] uppercase tracking-[0.14em] text-gray-500\" data-kid=\"1-2-4-1-3-2\">\n                        Quality grades\n                    </p>\n                </div>\n                <div class=\"p-6 lg:p-8\" data-kid=\"1-2-4-1-4\">\n                    <p class=\"fc-mono text-3xl font-semibold text-emerald-700\" data-kid=\"1-2-4-1-4-1\">\n                        100%\n                    </p>\n                    <p class=\"mt-2 text-[10px] uppercase tracking-[0.14em] text-gray-500\" data-kid=\"1-2-4-1-4-2\">\n                        Traceable payments\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-6 p-8 lg:p-10\" data-kid=\"1-2-4-2\">\n                <img alt=\"Fresh vegetables arranged for a produce delivery, by Randy Fath on Unsplash\" class=\"h-24 w-24 shrink-0 object-cover grayscale-[10%]\" data-kid=\"1-2-4-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1597362925123-77861d3fbac7?auto=format&w=420&q=80&fit=crop\"/>\n                <div data-kid=\"1-2-4-2-2\">\n                    <p class=\"fc-mono text-[10px] uppercase tracking-[0.16em] text-emerald-700\" data-kid=\"1-2-4-2-2-1\">\n                        Direct from the source\n                    </p>\n                    <p class=\"fc-display mt-2 text-2xl font-bold uppercase leading-none\" data-kid=\"1-2-4-2-2-2\">\n                        Good food, good timing.\n                    </p>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-gray-300 bg-gray-100\" data-kid=\"1-3\">\n        <div class=\"mx-auto grid max-w-[1280px] gap-8 px-8 py-10 sm:grid-cols-[1.2fr_1fr_1fr] lg:px-12\" data-kid=\"1-3-1\">\n            <div data-kid=\"1-3-1-1\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-3-1-1-1\">\n                    <span class=\"flex h-7 w-7 items-center justify-center bg-emerald-700 text-sm text-white\" data-kid=\"1-3-1-1-1-1\">\n                        <i class=\"ti ti-leaf\" data-kid=\"1-3-1-1-1-1-1\">\n                        </i>\n                    </span>\n                    <span class=\"fc-display text-lg font-bold\" data-kid=\"1-3-1-1-1-2\">\n                        FRESHCRATE.\n                    </span>\n                </div>\n                <p class=\"mt-4 max-w-xs text-xs leading-5 text-gray-500\" data-kid=\"1-3-1-1-2\">\n                    FreshCrate · Farm-fresh produce delivered within 48h of harvest · Greater Accra\n                </p>\n            </div>\n            <div data-kid=\"1-3-1-2\">\n                <p class=\"fc-mono text-[10px] uppercase tracking-[0.18em] text-gray-500\" data-kid=\"1-3-1-2-1\">\n                    Service promise\n                </p>\n                <p class=\"mt-3 text-sm font-semibold\" data-kid=\"1-3-1-2-2\">\n                    Reducing post-harvest loss by connecting smallholder farmers directly to urban households.\n                </p>\n            </div>\n            <div class=\"sm:text-right\" data-kid=\"1-3-1-3\">\n                <p class=\"fc-mono text-[10px] uppercase tracking-[0.18em] text-gray-500\" data-kid=\"1-3-1-3-1\">\n                    Status\n                </p>\n                <p class=\"mt-3 inline-flex items-center gap-2 text-sm font-semibold\" data-kid=\"1-3-1-3-2\" data-name=\"footer service status indicator\">\n                    <span class=\"h-2 w-2 rounded-full bg-emerald-600\" data-kid=\"1-3-1-3-2-1\">\n                    </span>\n                    All systems operational\n                </p>\n                <p class=\"mt-2 text-xs text-gray-500\" data-kid=\"1-3-1-3-3\">\n                    Mobile Money · Card · Doorstep routes\n                </p>\n            </div>\n        </div>\n        <div class=\"border-t border-gray-300 px-8 py-4 text-center text-[10px] uppercase tracking-[0.16em] text-gray-500\" data-kid=\"1-3-2\">\n            Fresh supply / Fair pricing / Fewer wasted harvests\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-08-01T19:15:09.614990+00:00",
      "modified": "2026-08-01T19:15:32.614340+00:00",
      "id": "var_25670be397b6"
    },
    "var_dac142ed61ea": {
      "type": "variant",
      "label": "FreshCrate — Tactile Farm-to-Door",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.34.0/tabler-icons.min.css');\n  .fc-display { font-family: 'Manrope', sans-serif; }\n  .fc-body { font-family: 'DM Sans', sans-serif; }\n  .fc-path-line { background-image: linear-gradient(to bottom, rgba(5,150,105,.42) 50%, transparent 50%); background-size: 2px 12px; }\n  .fc-soft-shadow { box-shadow: 0 20px 50px rgba(62,58,55,.10), 0 4px 14px rgba(62,58,55,.06); }\n  .fc-card-shadow { box-shadow: 0 12px 30px rgba(62,58,55,.08), 0 2px 8px rgba(62,58,55,.05); }\n</style>\n<div class=\"fc-body min-h-screen overflow-hidden bg-[#F4F7F4] text-[#3E3A37] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"relative z-20 mx-auto flex max-w-[1160px] items-center justify-between px-6 py-5 lg:px-0\" data-kid=\"1-1\" data-name=\"main navigation header\">\n        <a class=\"fc-display flex items-center gap-3 text-[20px] font-extrabold tracking-[-0.04em] text-[#126b52]\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#\">\n            <span class=\"flex h-10 w-10 items-center justify-center rounded-[14px] bg-[#126b52] text-[18px] text-white shadow-[0_8px_20px_rgba(18,107,82,.22)]\" data-kid=\"1-1-1-1\" data-name=\"brand logo icon container\">\n                <i class=\"ti ti-leaf\" data-kid=\"1-1-1-1-1\" data-name=\"leaf icon\">\n                </i>\n            </span>\n            FreshCrate\n        </a>\n        <nav class=\"hidden items-center gap-8 text-[13px] font-semibold text-[#69736d] md:flex\" data-kid=\"1-1-2\" data-name=\"navigation link group\">\n            <a class=\"hover:text-[#126b52]\" data-kid=\"1-1-2-1\" data-name=\"how it works navigation link\" href=\"#how-it-works\">\n                How it works\n            </a>\n            <a class=\"hover:text-[#126b52]\" data-kid=\"1-1-2-2\" data-name=\"why freshcrate navigation link\" href=\"#why-freshcrate\">\n                Why FreshCrate\n            </a>\n            <a class=\"hover:text-[#126b52]\" data-kid=\"1-1-2-3\" data-name=\"crate plans navigation link\" href=\"#crates\">\n                Crate plans\n            </a>\n        </nav>\n        <div class=\"flex items-center gap-3\" data-kid=\"1-1-3\" data-name=\"auth and cta button group\">\n            <a class=\"hidden rounded-full px-4 py-2 text-[13px] font-semibold text-[#58645e] hover:bg-white/80 sm:inline-flex\" data-kid=\"1-1-3-1\" data-name=\"log in button\" href=\"#\">\n                Log in\n            </a>\n            <a class=\"inline-flex items-center gap-2 rounded-full bg-[#126b52] px-5 py-3 text-[13px] font-bold text-white shadow-[0_8px_18px_rgba(18,107,82,.2)] hover:bg-[#0d5d46]\" data-kid=\"1-1-3-2\" data-name=\"pick a crate primary button\" href=\"#crates\">\n                Pick a crate\n                <i class=\"ti ti-arrow-up-right text-[15px]\" data-kid=\"1-1-3-2-1\" data-name=\"arrow up right icon\">\n                </i>\n            </a>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\">\n        <section class=\"relative mx-auto max-w-[1160px] px-6 pb-16 pt-5 lg:px-0 lg:pb-24 lg:pt-10\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"pointer-events-none absolute -left-32 top-20 h-72 w-72 rounded-full bg-[#D2A383]/20 blur-3xl\" data-kid=\"1-2-1-1\" data-name=\"decorative left blur orb\">\n            </div>\n            <div class=\"pointer-events-none absolute -right-28 bottom-10 h-80 w-80 rounded-full bg-[#8dcfb4]/20 blur-3xl\" data-kid=\"1-2-1-2\" data-name=\"decorative right blur orb\">\n            </div>\n            <div class=\"relative overflow-hidden rounded-[36px] bg-[#dcebe1] p-3 fc-soft-shadow lg:p-4\" data-kid=\"1-2-1-3\" data-name=\"hero content container\">\n                <div class=\"absolute inset-0 overflow-hidden rounded-[30px]\" data-kid=\"1-2-1-3-1\" data-name=\"hero image wrapper\">\n                    <img alt=\"Top-down basket of seasonal vegetables by Vije Vijendranath on Unsplash\" class=\"h-full w-full object-cover opacity-[.18] mix-blend-multiply\" data-kid=\"1-2-1-3-1-1\" data-name=\"hero vegetable background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1631021967261-c57ee4dfa9bb?auto=format&w=1400&q=80&fit=crop\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-br from-[#eff7ef]/95 via-[#e8f2e9]/85 to-[#cfe1d3]/70\" data-kid=\"1-2-1-3-1-2\" data-name=\"hero image gradient overlay\">\n                    </div>\n                </div>\n                <div class=\"relative grid min-h-[570px] overflow-hidden rounded-[28px] bg-[#f8fbf6]/90 lg:grid-cols-[1.02fr_.98fr]\" data-kid=\"1-2-1-3-2\" data-name=\"hero grid layout container\">\n                    <div class=\"flex flex-col justify-between p-8 sm:p-12 lg:p-16\" data-kid=\"1-2-1-3-2-1\" data-name=\"hero text content section\">\n                        <div class=\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[.16em] text-[#126b52]\" data-kid=\"1-2-1-3-2-1-1\" data-name=\"hero eyebrow container\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#D2A383]\" data-kid=\"1-2-1-3-2-1-1-1\" data-name=\"hero eyebrow indicator dot\">\n                            </span>\n                            Farm-to-door, made simple\n                        </div>\n                        <div class=\"max-w-[600px] py-10 lg:py-0\" data-kid=\"1-2-1-3-2-1-2\" data-name=\"hero headline and subtext group\">\n                            <h1 class=\"fc-display max-w-[600px] text-[clamp(2.8rem,5vw,5.55rem)] font-extrabold leading-[.98] tracking-[-0.065em] text-[#28493d]\" data-kid=\"1-2-1-3-2-1-2-1\" data-name=\"hero main headline text\">\n                                Farm-fresh produce.\n                                <br data-kid=\"1-2-1-3-2-1-2-1-1\"/>\n                                <span class=\"text-[#126b52]\" data-kid=\"1-2-1-3-2-1-2-1-2\" data-name=\"hero headline highlight text\">\n                                    Delivered like clockwork.\n                                </span>\n                            </h1>\n                            <p class=\"mt-7 max-w-[560px] text-[17px] leading-8 text-[#64716a]\" data-kid=\"1-2-1-3-2-1-2-2\" data-name=\"hero descriptive paragraph\">\n                                A weekly subscription of seasonal fruit and vegetables, sourced directly from smallholder farms in the Greater Accra Region and delivered to your door within 48 hours of harvest — no markets, no negotiation, no surprises.\n                            </p>\n                            <div class=\"mt-9 flex flex-col gap-3 sm:flex-row\" data-kid=\"1-2-1-3-2-1-2-3\" data-name=\"hero call-to-action button group\">\n                                <a class=\"inline-flex items-center justify-center gap-3 rounded-full bg-[#126b52] px-6 py-4 text-[14px] font-bold text-white shadow-[0_12px_22px_rgba(18,107,82,.2)] hover:bg-[#0d5d46]\" data-kid=\"1-2-1-3-2-1-2-3-1\" data-name=\"hero primary pick crate button\" href=\"#crates\">\n                                    Pick Your Crate\n                                    <i class=\"ti ti-arrow-right text-[17px]\" data-kid=\"1-2-1-3-2-1-2-3-1-1\" data-name=\"arrow right icon\">\n                                    </i>\n                                </a>\n                                <a class=\"inline-flex items-center justify-center rounded-full border border-[#b8c9bc] bg-white/70 px-6 py-4 text-[14px] font-bold text-[#486055] hover:bg-white\" data-kid=\"1-2-1-3-2-1-2-3-2\" data-name=\"hero secondary create account button\" href=\"#\">\n                                    Create an account\n                                </a>\n                            </div>\n                        </div>\n                        <div class=\"flex flex-wrap items-center gap-x-7 gap-y-3 text-[12px] font-semibold text-[#758179]\" data-kid=\"1-2-1-3-2-1-3\" data-name=\"hero benefit features list\">\n                            <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-3-2-1-3-1\" data-name=\"harvest benefit tag\">\n                                <i class=\"ti ti-clock-check text-[17px] text-[#126b52]\" data-kid=\"1-2-1-3-2-1-3-1-1\" data-name=\"clock check icon\">\n                                </i>\n                                Harvest to home in 48h\n                            </span>\n                            <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-3-2-1-3-2\" data-name=\"delivery benefit tag\">\n                                <i class=\"ti ti-map-pin-check text-[17px] text-[#126b52]\" data-kid=\"1-2-1-3-2-1-3-2-1\" data-name=\"map pin check icon\">\n                                </i>\n                                Greater Accra delivery\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"relative hidden min-h-[500px] overflow-hidden rounded-[24px] bg-[#c6dccb] lg:block\" data-kid=\"1-2-1-3-2-2\" data-name=\"hero side image container\">\n                        <img alt=\"Top-down basket of colorful vegetables by Sofia Holmberg on Unsplash\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-2-1-3-2-2-1\" data-name=\"hero side vegetable image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1706828668401-33e54edd85e7?auto=format&w=900&q=80&fit=crop\"/>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#193f31]/65 via-transparent to-[#193f31]/5\" data-kid=\"1-2-1-3-2-2-2\" data-name=\"hero side image gradient overlay\">\n                        </div>\n                        <div class=\"absolute bottom-7 left-7 right-7 rounded-[22px] border border-white/40 bg-white/82 p-5 backdrop-blur-md\" data-kid=\"1-2-1-3-2-2-3\" data-name=\"hero progress card container\">\n                            <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-2-1-3-2-2-3-1\" data-name=\"progress card header\">\n                                <div data-kid=\"1-2-1-3-2-2-3-1-1\" data-name=\"progress card text group\">\n                                    <p class=\"text-[11px] font-bold uppercase tracking-[.16em] text-[#126b52]\" data-kid=\"1-2-1-3-2-2-3-1-1-1\" data-name=\"progress card eyebrow text\">\n                                        This week’s rhythm\n                                    </p>\n                                    <p class=\"fc-display mt-2 text-[22px] font-extrabold tracking-[-.04em] text-[#28493d]\" data-kid=\"1-2-1-3-2-2-3-1-1-2\" data-name=\"progress card title text\">\n                                        Harvested for your table\n                                    </p>\n                                </div>\n                                <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[#D2A383] text-white\" data-kid=\"1-2-1-3-2-2-3-1-2\" data-name=\"progress card icon container\">\n                                    <i class=\"ti ti-sun-high text-[19px]\" data-kid=\"1-2-1-3-2-2-3-1-2-1\" data-name=\"sun high icon\">\n                                    </i>\n                                </span>\n                            </div>\n                            <div class=\"mt-4 h-1.5 overflow-hidden rounded-full bg-[#d7e3d8]\" data-kid=\"1-2-1-3-2-2-3-2\" data-name=\"progress bar track\">\n                                <div class=\"h-full w-[72%] rounded-full bg-[#126b52]\" data-kid=\"1-2-1-3-2-2-3-2-1\" data-name=\"progress bar indicator fill\">\n                                </div>\n                            </div>\n                            <div class=\"mt-2 flex justify-between text-[11px] font-semibold text-[#718077]\" data-kid=\"1-2-1-3-2-2-3-3\" data-name=\"progress stage labels\">\n                                <span data-kid=\"1-2-1-3-2-2-3-3-1\" data-name=\"progress picked at farm label\">\n                                    Picked at farm\n                                </span>\n                                <span data-kid=\"1-2-1-3-2-2-3-3-2\" data-name=\"progress on way label\">\n                                    On its way to you\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1160px] px-6 pb-20 lg:px-0 lg:pb-28\" data-kid=\"1-2-2\" data-name=\"why freshcrate section\" id=\"why-freshcrate\">\n            <div class=\"mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end\" data-kid=\"1-2-2-1\" data-name=\"section header group\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"section title group\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[.18em] text-[#126b52]\" data-kid=\"1-2-2-1-1-1\" data-name=\"section eyebrow text\">\n                        Why FreshCrate\n                    </p>\n                    <h2 class=\"fc-display mt-2 text-3xl font-extrabold tracking-[-.05em] text-[#28493d] sm:text-4xl\" data-kid=\"1-2-2-1-1-2\" data-name=\"section main title text\">\n                        The better weekly ritual.\n                    </h2>\n                </div>\n                <p class=\"max-w-[310px] text-sm leading-6 text-[#77827b]\" data-kid=\"1-2-2-1-2\" data-name=\"section description text\">\n                    Less time negotiating at the market. More time cooking, sharing, and knowing where your food came from.\n                </p>\n            </div>\n            <div class=\"grid gap-4 lg:grid-cols-12 lg:grid-rows-2\" data-kid=\"1-2-2-2\" data-name=\"features grid layout\">\n                <article class=\"relative overflow-hidden rounded-[26px] bg-[#126b52] p-7 text-white fc-card-shadow lg:col-span-5 lg:row-span-2 lg:p-9\" data-kid=\"1-2-2-2-1\" data-name=\"highlighted feature card\">\n                    <div class=\"absolute -right-10 -top-10 h-40 w-40 rounded-full border-[22px] border-white/10\" data-kid=\"1-2-2-2-1-1\" data-name=\"decorative circle element\">\n                    </div>\n                    <span class=\"flex h-12 w-12 items-center justify-center rounded-[17px] bg-white/15 text-[24px]\" data-kid=\"1-2-2-2-1-2\" data-name=\"feature icon container\">\n                        <i class=\"ti ti-clock-check\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"clock check icon\">\n                        </i>\n                    </span>\n                    <h3 class=\"fc-display mt-14 max-w-[280px] text-3xl font-extrabold leading-tight tracking-[-.05em]\" data-kid=\"1-2-2-2-1-3\" data-name=\"feature title text\">\n                        Within 48 hours\n                    </h3>\n                    <p class=\"mt-4 max-w-[320px] text-[15px] leading-7 text-white/72\" data-kid=\"1-2-2-2-1-4\" data-name=\"feature description text\">\n                        From farm gate to your kitchen counter. The traditional market chain takes 4–7 days; FreshCrate cuts it to under 48 hours.\n                    </p>\n                    <div class=\"absolute bottom-8 right-8 flex items-end gap-1 text-[#b9e0c8]\" data-kid=\"1-2-2-2-1-5\" data-name=\"feature value highlight group\">\n                        <span class=\"fc-display text-5xl font-extrabold tracking-[-.08em]\" data-kid=\"1-2-2-2-1-5-1\" data-name=\"feature highlight number\">\n                            48\n                        </span>\n                        <span class=\"mb-2 text-sm font-bold\" data-kid=\"1-2-2-2-1-5-2\" data-name=\"feature highlight unit\">\n                            hrs\n                        </span>\n                    </div>\n                </article>\n                <article class=\"rounded-[26px] bg-[#fffdfa] p-7 fc-card-shadow lg:col-span-7 lg:p-8\" data-kid=\"1-2-2-2-2\" data-name=\"feature card\">\n                    <div class=\"flex items-start justify-between gap-5\" data-kid=\"1-2-2-2-2-1\" data-name=\"feature card content\">\n                        <div data-kid=\"1-2-2-2-2-1-1\" data-name=\"feature card text and icon group\">\n                            <span class=\"flex h-11 w-11 items-center justify-center rounded-[15px] bg-[#e7f2e8] text-[22px] text-[#126b52]\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"feature icon container\">\n                                <i class=\"ti ti-seedling\" data-kid=\"1-2-2-2-2-1-1-1-1\" data-name=\"seedling icon\">\n                                </i>\n                            </span>\n                            <h3 class=\"fc-display mt-6 text-2xl font-extrabold tracking-[-.05em] text-[#28493d]\" data-kid=\"1-2-2-2-2-1-1-2\" data-name=\"feature title text\">\n                                Less waste, more farm income\n                            </h3>\n                            <p class=\"mt-2 max-w-[570px] text-[14px] leading-6 text-[#768078]\" data-kid=\"1-2-2-2-2-1-1-3\" data-name=\"feature description text\">\n                                Subscription demand is matched to farm supply. We aim to cut in-chain produce loss from 20–50% to under 10% and raise partner-farm incomes.\n                            </p>\n                        </div>\n                        <span class=\"rounded-full bg-[#f1e2d7] px-3 py-1 text-[10px] font-bold uppercase tracking-[.12em] text-[#9a684b]\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"feature impact label\">\n                            Impact\n                        </span>\n                    </div>\n                </article>\n                <article class=\"rounded-[26px] bg-[#f0e5dc] p-7 fc-card-shadow lg:col-span-4 lg:p-8\" data-kid=\"1-2-2-2-3\" data-name=\"feature card\">\n                    <span class=\"flex h-11 w-11 items-center justify-center rounded-[15px] bg-white/65 text-[22px] text-[#9a684b]\" data-kid=\"1-2-2-2-3-1\" data-name=\"feature icon container\">\n                        <i class=\"ti ti-receipt-2\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"receipt icon\">\n                        </i>\n                    </span>\n                    <h3 class=\"fc-display mt-5 text-xl font-extrabold tracking-[-.05em] text-[#5a4639]\" data-kid=\"1-2-2-2-3-2\" data-name=\"feature title text\">\n                        Transparent, consistent pricing\n                    </h3>\n                    <p class=\"mt-2 text-[14px] leading-6 text-[#806f65]\" data-kid=\"1-2-2-2-3-3\" data-name=\"feature description text\">\n                        One fixed weekly price. No spot-market volatility, no price negotiation. Quality is graded A/B/C before packing.\n                    </p>\n                </article>\n                <article class=\"rounded-[26px] bg-[#dcebe1] p-7 fc-card-shadow lg:col-span-3 lg:p-8\" data-kid=\"1-2-2-2-4\" data-name=\"feature card\">\n                    <span class=\"flex h-11 w-11 items-center justify-center rounded-[15px] bg-white/70 text-[22px] text-[#126b52]\" data-kid=\"1-2-2-2-4-1\" data-name=\"feature icon container\">\n                        <i class=\"ti ti-device-mobile-dollar\" data-kid=\"1-2-2-2-4-1-1\" data-name=\"mobile payment icon\">\n                        </i>\n                    </span>\n                    <h3 class=\"fc-display mt-5 text-xl font-extrabold tracking-[-.05em] text-[#28493d]\" data-kid=\"1-2-2-2-4-2\" data-name=\"feature title text\">\n                        Pay with Mobile Money\n                    </h3>\n                    <p class=\"mt-2 text-[14px] leading-6 text-[#687970]\" data-kid=\"1-2-2-2-4-3\" data-name=\"feature description text\">\n                        Auto-billing via MTN Mobile Money (and card) on your subscription cycle. Cashless, traceable, convenient.\n                    </p>\n                </article>\n            </div>\n        </section>\n        <section class=\"relative overflow-hidden bg-[#fffdfa] py-20 lg:py-24\" data-kid=\"1-2-3\" data-name=\"how it works section\" id=\"how-it-works\">\n            <div class=\"mx-auto max-w-[1160px] px-6 lg:px-0\" data-kid=\"1-2-3-1\" data-name=\"how it works content container\">\n                <div class=\"max-w-[500px]\" data-kid=\"1-2-3-1-1\" data-name=\"section intro group\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[.18em] text-[#126b52]\" data-kid=\"1-2-3-1-1-1\" data-name=\"section eyebrow text\">\n                        From farm to front door\n                    </p>\n                    <h2 class=\"fc-display mt-2 text-3xl font-extrabold tracking-[-.05em] text-[#28493d] sm:text-4xl\" data-kid=\"1-2-3-1-1-2\" data-name=\"section main title text\">\n                        How it works\n                    </h2>\n                    <p class=\"mt-3 text-[15px] leading-7 text-[#77827b]\" data-kid=\"1-2-3-1-1-3\" data-name=\"section description text\">\n                        A calm, predictable rhythm from seasonal harvest to your weekly kitchen reset.\n                    </p>\n                </div>\n                <div class=\"relative mt-14 grid gap-8 lg:grid-cols-4 lg:gap-10\" data-kid=\"1-2-3-1-2\" data-name=\"steps grid layout\">\n                    <div class=\"fc-path-line pointer-events-none absolute left-[21px] top-8 hidden h-[calc(100%-56px)] w-px lg:left-0 lg:top-[26px] lg:block lg:h-px lg:w-full lg:bg-[linear-gradient(to_right,rgba(5,150,105,.42)_50%,transparent_50%)] lg:bg-[length:12px_2px]\" data-kid=\"1-2-3-1-2-1\" data-name=\"connector line graphic\">\n                    </div>\n                    <article class=\"relative flex gap-4 lg:block\" data-kid=\"1-2-3-1-2-2\" data-name=\"step one card\">\n                        <span class=\"relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-4 border-[#fffdfa] bg-[#126b52] text-sm font-extrabold text-white shadow-[0_0_0_1px_rgba(18,107,82,.2)]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"step number indicator\">\n                            1\n                        </span>\n                        <div class=\"pt-1 lg:pt-7\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"step text content\">\n                            <h3 class=\"fc-display text-xl font-extrabold tracking-[-.04em] text-[#28493d]\" data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"step title text\">\n                                Choose a crate\n                            </h3>\n                            <p class=\"mt-2 max-w-[230px] text-[14px] leading-6 text-[#77827b]\" data-kid=\"1-2-3-1-2-2-2-2\" data-name=\"step description text\">\n                                Small, Family, Premium, or Restaurant.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"relative flex gap-4 lg:block\" data-kid=\"1-2-3-1-2-3\" data-name=\"step two card\">\n                        <span class=\"relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-4 border-[#fffdfa] bg-[#126b52] text-sm font-extrabold text-white shadow-[0_0_0_1px_rgba(18,107,82,.2)]\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"step number indicator\">\n                            2\n                        </span>\n                        <div class=\"pt-1 lg:pt-7\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"step text content\">\n                            <h3 class=\"fc-display text-xl font-extrabold tracking-[-.04em] text-[#28493d]\" data-kid=\"1-2-3-1-2-3-2-1\" data-name=\"step title text\">\n                                Customize\n                            </h3>\n                            <p class=\"mt-2 max-w-[230px] text-[14px] leading-6 text-[#77827b]\" data-kid=\"1-2-3-1-2-3-2-2\" data-name=\"step description text\">\n                                Swap or add seasonal produce you love (or skip what you don't).\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"relative flex gap-4 lg:block\" data-kid=\"1-2-3-1-2-4\" data-name=\"step three card\">\n                        <span class=\"relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-4 border-[#fffdfa] bg-[#126b52] text-sm font-extrabold text-white shadow-[0_0_0_1px_rgba(18,107,82,.2)]\" data-kid=\"1-2-3-1-2-4-1\" data-name=\"step number indicator\">\n                            3\n                        </span>\n                        <div class=\"pt-1 lg:pt-7\" data-kid=\"1-2-3-1-2-4-2\" data-name=\"step text content\">\n                            <h3 class=\"fc-display text-xl font-extrabold tracking-[-.04em] text-[#28493d]\" data-kid=\"1-2-3-1-2-4-2-1\" data-name=\"step title text\">\n                                We harvest + pack\n                            </h3>\n                            <p class=\"mt-2 max-w-[230px] text-[14px] leading-6 text-[#77827b]\" data-kid=\"1-2-3-1-2-4-2-2\" data-name=\"step description text\">\n                                Farms harvest to order; our hub grades and packs your crate.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"relative flex gap-4 lg:block\" data-kid=\"1-2-3-1-2-5\" data-name=\"step four card\">\n                        <span class=\"relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-4 border-[#fffdfa] bg-[#126b52] text-sm font-extrabold text-white shadow-[0_0_0_1px_rgba(18,107,82,.2)]\" data-kid=\"1-2-3-1-2-5-1\" data-name=\"step number indicator\">\n                            4\n                        </span>\n                        <div class=\"pt-1 lg:pt-7\" data-kid=\"1-2-3-1-2-5-2\" data-name=\"step text content\">\n                            <h3 class=\"fc-display text-xl font-extrabold tracking-[-.04em] text-[#28493d]\" data-kid=\"1-2-3-1-2-5-2-1\" data-name=\"step title text\">\n                                Doorstep delivery\n                            </h3>\n                            <p class=\"mt-2 max-w-[230px] text-[14px] leading-6 text-[#77827b]\" data-kid=\"1-2-3-1-2-5-2-2\" data-name=\"step description text\">\n                                Route-optimized delivery within 48h of harvest.\n                            </p>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1160px] px-6 py-20 lg:px-0 lg:py-24\" data-kid=\"1-2-4\" data-name=\"crate plans call-to-action section\" id=\"crates\">\n            <div class=\"flex flex-col justify-between gap-6 rounded-[30px] bg-[#dcebe1] p-7 sm:p-9 lg:flex-row lg:items-center lg:p-12\" data-kid=\"1-2-4-1\" data-name=\"call-to-action container\">\n                <div data-kid=\"1-2-4-1-1\" data-name=\"title group\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[.18em] text-[#126b52]\" data-kid=\"1-2-4-1-1-1\" data-name=\"eyebrow text\">\n                        Your week, sorted\n                    </p>\n                    <h2 class=\"fc-display mt-2 max-w-[550px] text-3xl font-extrabold tracking-[-.06em] text-[#28493d] sm:text-4xl\" data-kid=\"1-2-4-1-1-2\" data-name=\"headline text\">\n                        Make your next grocery run the easiest one.\n                    </h2>\n                </div>\n                <a class=\"inline-flex shrink-0 items-center justify-center gap-3 rounded-full bg-[#126b52] px-6 py-4 text-[14px] font-bold text-white shadow-[0_10px_20px_rgba(18,107,82,.18)]\" data-kid=\"1-2-4-1-2\" data-name=\"explore plans button\" href=\"#\">\n                    Explore crate plans\n                    <i class=\"ti ti-arrow-up-right text-[17px]\" data-kid=\"1-2-4-1-2-1\" data-name=\"arrow up right icon\">\n                    </i>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#d9e5dc] bg-[#f8fbf6]\" data-kid=\"1-3\" data-name=\"footer container\">\n        <div class=\"mx-auto flex max-w-[1160px] flex-col gap-7 px-6 py-10 lg:px-0\" data-kid=\"1-3-1\" data-name=\"footer content wrapper\">\n            <div class=\"flex flex-col justify-between gap-6 sm:flex-row sm:items-center\" data-kid=\"1-3-1-1\" data-name=\"footer primary info section\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"brand logo and description group\">\n                    <a class=\"fc-display text-xl font-extrabold tracking-[-.05em] text-[#126b52]\" data-kid=\"1-3-1-1-1-1\" data-name=\"brand logo text link\" href=\"#\">\n                        FreshCrate\n                    </a>\n                    <p class=\"mt-2 text-sm text-[#768078]\" data-kid=\"1-3-1-1-1-2\" data-name=\"footer description text\">\n                        Farm-fresh produce delivered within 48h of harvest · Greater Accra\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap gap-2 text-[11px] font-bold text-[#66746b]\" data-kid=\"1-3-1-1-2\" data-name=\"footer benefits badge group\">\n                    <span class=\"rounded-full border border-[#cdddcf] bg-white px-3 py-2\" data-kid=\"1-3-1-1-2-1\" data-name=\"traceable sourcing badge\">\n                        <i class=\"ti ti-shield-check mr-1 text-[#126b52]\" data-kid=\"1-3-1-1-2-1-1\" data-name=\"shield icon\">\n                        </i>\n                        Traceable sourcing\n                    </span>\n                    <span class=\"rounded-full border border-[#cdddcf] bg-white px-3 py-2\" data-kid=\"1-3-1-1-2-2\" data-name=\"secure momo badge\">\n                        <i class=\"ti ti-credit-card-pay mr-1 text-[#126b52]\" data-kid=\"1-3-1-1-2-2-1\" data-name=\"credit card icon\">\n                        </i>\n                        Secure MoMo\n                    </span>\n                    <span class=\"rounded-full border border-[#cdddcf] bg-white px-3 py-2\" data-kid=\"1-3-1-1-2-3\" data-name=\"delivery speed badge\">\n                        <i class=\"ti ti-truck-delivery mr-1 text-[#126b52]\" data-kid=\"1-3-1-1-2-3-1\" data-name=\"truck delivery icon\">\n                        </i>\n                        48h delivery\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex flex-col justify-between gap-3 border-t border-[#d9e5dc] pt-5 text-xs text-[#8b958e] sm:flex-row\" data-kid=\"1-3-1-2\" data-name=\"footer secondary info section\">\n                <p data-kid=\"1-3-1-2-1\" data-name=\"footer mission statement text\">\n                    Reducing post-harvest loss by connecting smallholder farmers directly to urban households.\n                </p>\n                <p data-kid=\"1-3-1-2-2\" data-name=\"footer tagline text\">\n                    Fresh food, on a better rhythm.\n                </p>\n            </div>\n        </div>\n    </footer>\n</div>\n",

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- Application core ----

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  phone         String?    @unique
  phoneVerified Boolean    @default(false)
  password      String?    // bcrypt hash
  image         String?
  role          Role       @default(CUSTOMER)
  address       Json?      // { line1, area, landmark, lat, lng }
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  subscriptions Subscription[]
  feedbacks     Feedback[]
  sessions      Session[]
  deliveries    Delivery[] @relation("DriverDeliveries")
}

enum Role {
  CUSTOMER
  ADMIN
  FARMER
  DELIVERY
}

model Farm {
  id            String   @id @default(cuid())
  name          String
  contactPerson String
  phone         String
  location      String
  region        String   @default("Greater Accra")
  certification String?
  produceItems  ProduceItem[]
  inventory     InventoryItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProduceItem {
  id           String       @id @default(cuid())
  name         String @unique
  category     Category     @default(VEGETABLE)
  unit         String       @default("bunch")
  unitPrice    Float        // GHS per unit (farm gate)
  seasonality  String?
  imageUrl     String?
  isActive     Boolean      @default(true)
  farmer       Farm?        @relation(fields: [farmerId], references: [id])
  farmerId     String?
  inventory        InventoryItem[]
  orderItems       OrderItem[]
  crateItems       CrateItem[]
  subscriptionItems SubscriptionItem[]
  createdAt        DateTime     @default(now())
}

enum Category {
  FRUIT
  VEGETABLE
  HERB
  ADDON
  SEEDLING
}

model CratePlan {
  id            String      @id @default(cuid())
  name          PlanName @unique
  description   String
  basePrice     Float       // GHS per cycle
  currency      String      @default("GHS")
  frequency     Frequency   @default(WEEKLY)
  maxItems      Int
  isActive      Boolean     @default(true)
  items         CrateItem[]
  subscriptions Subscription[]
}

enum PlanName {
  SMALL
  FAMILY
  PREMIUM
  RESTAURANT
}
enum Frequency {
  WEEKLY
  BIWEEKLY
}

model CrateItem {
  id            String     @id @default(cuid())
  cratePlan     CratePlan  @relation(fields: [cratePlanId], references: [id])
  cratePlanId   String
  produceItem   ProduceItem @relation(fields: [produceItemId], references: [id])
  produceItemId String
  defaultQty    Float?
  isOptional    Boolean    @default(true)
  @@unique([cratePlanId, produceItemId])
}

model Subscription {
  id              String             @id @default(cuid())
  user            User               @relation(fields: [userId], references: [id])
  userId          String
  cratePlan       CratePlan          @relation(fields: [cratePlanId], references: [id])
  cratePlanId     String
  status          SubscriptionStatus @default(PENDING)
  frequency       Frequency          @default(WEEKLY)
  startDate       DateTime
  nextBillingAt   DateTime
  pausedAt        DateTime?
  cancelledAt     DateTime?
  deliveryAddress Json               // snapshot at signup
  paymentMethod   PaymentMethod      @default(MOMO)
  customItems     SubscriptionItem[]
  orders          Order[]
  payments        Payment[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELED
}
enum PaymentMethod {
  MOMO
  CARD
}

model SubscriptionItem {
  id              String     @id @default(cuid())
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String
  produceItem     ProduceItem  @relation(fields: [produceItemId], references: [id])
  produceItemId   String
  qty             Float
  action          ItemAction  @default(KEEP)
  @@unique([subscriptionId, produceItemId])
}

enum ItemAction {
  KEEP
  SWAP
  REMOVE
}

model Order {
  id              String   @id @default(cuid())
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String
  status          OrderStatus @default(PENDING) // PENDING->PICKED->PACKED->OUT_FOR_DELIVERY->DELIVERED
  scheduledDate   DateTime
  deliveredAt     DateTime?
  totalValue      Float
  totalWeight     Float?
  items           OrderItem[]
  deliveries      DeliveryOrder[]
  payments        Payment[]
  feedbacks       Feedback[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

enum OrderStatus {
  PENDING
  PICKED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

model OrderItem {
  id            String   @id @default(cuid())
  order         Order    @relation(fields: [orderId], references: [id])
  orderId       String
  produceItem   ProduceItem @relation(fields: [produceItemId], references: [id])
  produceItemId String
  qty           Float
  unitPrice     Float
  inventory     InventoryOrderItem[]
}

// Traceability: which harvest batch went into which order line (BPR grading/packing traceability)
model InventoryItem {
  id            String   @id @default(cuid())
  produceItem   ProduceItem @relation(fields: [produceItemId], references: [id])
  produceItemId String
  farm          Farm?    @relation(fields: [farmerId], references: [id])
  farmerId      String?
  batchNo       String?
  status        InventoryStatus @default(HARVESTED)
  harvestDate   DateTime
  grade         Grade?
  weight        Float?
  expiresAt     DateTime?
  orderItems    InventoryOrderItem[]
  createdAt     DateTime @default(now())
}

enum InventoryStatus {
  HARVESTED
  GRADED
  PACKED
  DISPATCHED
  DELIVERED
  RETURNED
}
enum Grade {
  A
  B
  C_REJECT
}

model InventoryOrderItem {
  id              String        @id @default(cuid())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  orderItemId     String
  qtyUsed         Float
  @@unique([inventoryItemId, orderItemId])
}

model Delivery {
  id              String   @id @default(cuid())
  driver          User?    @relation("DriverDeliveries", fields: [driverId], references: [id])
  driverId        String?
  zone           String
  status          DeliveryStatus @default(PENDING)
  route          Route?   @relation(fields: [routeId], references: [id])
  routeId        String?
  orders         DeliveryOrder[]
  startedAt      DateTime?
  completedAt    DateTime?
  totalDistanceKm Float?
  estMinutes     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED
  IN_TRANSIT
  COMPLETED
  CANCELED
}

model DeliveryOrder {
  id           String   @id @default(cuid())
  delivery     Delivery @relation(fields: [deliveryId], references: [id])
  deliveryId   String
  order        Order    @relation(fields: [orderId], references: [id])
  orderId      String
  stopSequence Int      // route order index
  lat          Float?
  lng          Float?
  @@unique([deliveryId, orderId])
}

model Route {
  id              String    @id @default(cuid())
  deliveries      Delivery[]
  orderedStopJson String?   // JSON of ordered stop ids (VRP/OSRM output)
  distanceKm      Float?
  estMinutes      Int?
  completedAt     DateTime?
}

model Payment {
  id              String   @id @default(cuid())
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String?
  order           Order?    @relation(fields: [orderId], references: [id])
  orderId         String?
  provider        String    @default("MTN_MOMO") // MTN_MOMO | AIRTEL_MOMO | CARD
  amount          Float
  currency        String    @default("GHS")
  status          PaymentStatus @default(PENDING)
  providerRef     String?   // payerReference / transactionId from MTN
  mtnRequestId    String?   // X-Reference-Id we sent
  paidAt          DateTime?
  failureReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Feedback {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())
  @@unique([orderId, userId])
}

// ---- Sessions (custom auth, replaces next-auth models) ----
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  userAgent    String?
  createdAt    DateTime @default(now())
}
